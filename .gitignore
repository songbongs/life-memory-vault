# Local private config
memory-config.json

# API keys / tokens
*.key
*.token
.env
.env.local
.env.*.local

# 로컬 전용 문서 — 봇 ID 등 이 맥에서만 봐야 하는 대조표.
# 저장소가 공개(PUBLIC)이므로 본문에는 별칭만 쓰고 실제 값은 여기 둔다.
*.local.md

# 외부 도구가 남기는 세션 상태 파일 (작업 이어하기용 책갈피)
.omo/

# Runtime output
memory-output/
memory-state/
__pycache__/
*.pyc

# Telegram ops collector runtime files
scripts/.telegram-ops-queue.jsonl
scripts/.telegram-ops-offset

# Dependencies
node_modules/
.venv/
venv/

# Machine-specific Claude Code settings (has hardcoded absolute paths)
.claude/settings.local.json

# Claude Code auto-generated skill cache (regenerated from commands/)
.agents/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo
.rollback/

# Local backups (e.g. script.py.bak-YYYYMMDD_HHMMSS)
*.bak
*.bak-*
